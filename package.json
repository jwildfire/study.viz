    "safety-viz:check-source": "node scripts/vendor-safety-viz.mjs --check-source",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "vitest": "^4.1.9",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwildfire/study.viz.git"
  },
  "bugs": {
